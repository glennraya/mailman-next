# Generated by .github/workflows/release.yml on every tag. Edit the template
# in packaging/homebrew/mailman.rb.tmpl, not the copy in the tap.
class Mailman < Formula
  desc "Localhost mail catcher you can reply from"
  homepage "https://github.com/glennraya/mailman-next"
  version "__VERSION__"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/glennraya/mailman-next/releases/download/v__VERSION__/mailman-darwin-arm64"
      sha256 "__SHA_DARWIN_ARM64__"
    end
    on_intel do
      url "https://github.com/glennraya/mailman-next/releases/download/v__VERSION__/mailman-darwin-amd64"
      sha256 "__SHA_DARWIN_AMD64__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/glennraya/mailman-next/releases/download/v__VERSION__/mailman-linux-arm64"
      sha256 "__SHA_LINUX_ARM64__"
    end
    on_intel do
      url "https://github.com/glennraya/mailman-next/releases/download/v__VERSION__/mailman-linux-amd64"
      sha256 "__SHA_LINUX_AMD64__"
    end
  end

  def install
    # The release asset is the bare binary, named for its platform.
    bin.install Dir["mailman-*"].first => "mailman"
  end

  def caveats
    <<~EOS
      Mailman is installed but not running. Homebrew cannot start a service at
      install time, so one more command registers it to run at login:

          mailman service install

      The inbox is then at http://127.0.0.1:8383 and SMTP capture on 1983.
      `mailman service status` shows what is running, and the log is in
      ~/.mailman/mailman.log.

      `brew services` is deliberately not wired up here. Mailman registers its
      own launch agent so that one command works the same on macOS and Linux,
      and two managers would fight over the same two ports.
    EOS
  end

  test do
    # Deliberately not starting a server: Homebrew's sandbox would hit the
    # port preflight and fail for a reason that has nothing to do with the
    # formula.
    assert_match "mailman", shell_output("#{bin}/mailman -version")
  end
end
